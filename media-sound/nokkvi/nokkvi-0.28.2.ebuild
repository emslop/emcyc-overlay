RUST_MIN_VER="1.95"
inherit cargo desktop xdg

DESCRIPTION="Fast and beautiful Rust/Iced desktop client for Navidrome"
HOMEPAGE="https://github.com/f-o-o-g-s/nokkvi"
SRC_URI="
	https://github.com/f-o-o-g-s/nokkvi/archive/refs/tags/v${PV}.tar.gz
	-> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3.0-only"
SLOT="0"
KEYWORDS="~amd64"

# Upstream pins Git dependencies in Cargo.toml; Cargo cannot resolve them
# from a registry vendor snapshot without a dedicated vendor tarball.
RESTRICT="network-sandbox"

RDEPEND="
	dev-libs/wayland
	media-libs/vulkan-loader
	x11-libs/libxkbcommon
"
BDEPEND="
	virtual/pkgconfig
"

QA_FLAGS_IGNORED="usr/bin/${PN}"

src_configure() {
	cargo_src_configure
}

src_compile() {
	cargo_src_compile
}

src_install() {
	cargo_src_install

	newicon -s scalable assets/logo/nokkvi_master.svg "${PN}.svg"
	make_desktop_entry "${PN}" "Nokkvi" "${PN}" "AudioVideo;Audio;Player;"
}
